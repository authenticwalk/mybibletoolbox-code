{
  "env": {
  },
  "permissions": {
    "allow": [
      "Edit(/.claude/skills/**)",
      "Edit(/bible-study-tools/)",
      "Edit(/bible/)",
      "Edit(/plan/)",
      "Read(/)",
      "Write(/bible-study-tools/)",
      "Write(/plan/)",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "Deny(./.env)",
      "Deny(./secrets/**)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git config:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(pwd)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat | jq -r '.tool_input.command // empty' | tr '\\n' '\\0' | xargs -0 -I {} npx claude-flow@alpha hooks pre-command --command '{}' --validate-safety true --prepare-resources true"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true
}
